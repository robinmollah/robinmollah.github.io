:root
  --ink: #172024
  --ink-soft: #2f3b3f
  --muted: #5b666b
  --paper: #f8f4ea
  --paper-deep: #ece4d2
  --paper-panel: rgba(255, 253, 248, 0.86)
  --paper-panel-strong: #fffdf8
  --line: rgba(23, 32, 36, 0.14)
  --line-warm: rgba(136, 77, 57, 0.22)
  --navy: #123744
  --teal: #337a72
  --moss: #637849
  --clay: #884d39
  --clay-bright: #b76547
  --gold: #d59b32
  --white: #fffdf8
  --link-color: #884d39
  --link-hover-color: #123744
  --shadow: 0 20px 54px rgba(18, 36, 44, 0.13)
  --shadow-soft: 0 12px 32px rgba(18, 36, 44, 0.09)
  --radius-s: 8px
  --radius-m: 16px
  --radius-l: 24px
  --radius-pill: 999px
  --font-display: "Fraunces", Georgia, serif
  --font-body: "IBM Plex Sans", "Segoe UI", sans-serif
  --ease-editorial: cubic-bezier(0.2, 0.8, 0.2, 1)

html,
body
  background: var(--paper)

html
  scroll-behavior: smooth

body
  color: var(--ink)
  font-family: var(--font-body)
  font-size: 17px
  line-height: 1.68
  background-attachment: fixed
  position: relative

body:before
  content: ""
  position: fixed
  inset: 0
  z-index: -1
  pointer-events: none
  background: linear-gradient(90deg, rgba(23, 32, 36, 0.035) 1px, transparent 1px), linear-gradient(180deg, rgba(23, 32, 36, 0.035) 1px, transparent 1px), linear-gradient(180deg, var(--paper), var(--paper-deep))
  background-size: 80px 80px, 80px 80px, auto

::selection
  background: rgba(183, 101, 71, 0.22)
  color: var(--ink)

a
  color: var(--link-color)
  text-decoration-thickness: 1px
  text-underline-offset: 0.18em

a:hover,
a:focus
  color: var(--link-hover-color)

.use-motion .post-block,
.use-motion .pagination,
.use-motion .comments,
.use-motion .post-navigation
  visibility: visible

.headband
  height: 6px
  background: linear-gradient(90deg, var(--navy), var(--clay) 48%, var(--gold))

.header
  background: transparent

.site-brand-container
  background: linear-gradient(135deg, rgba(255, 253, 248, 0.94), rgba(236, 228, 210, 0.9)), var(--paper)
  border: 1px solid var(--line)
  border-radius: var(--radius-l)
  box-shadow: var(--shadow)
  margin: 0 auto 22px
  max-width: unquote('calc(100% - 28px)')
  overflow: hidden
  position: relative

.site-brand-container:before
  content: ""
  position: absolute
  inset: 12px
  border: 1px solid rgba(136, 77, 57, 0.11)
  border-radius: var(--radius-m)
  background: linear-gradient(90deg, rgba(23, 32, 36, 0.035) 1px, transparent 1px), linear-gradient(180deg, rgba(23, 32, 36, 0.03) 1px, transparent 1px)
  background-size: 34px 34px
  mask-image: radial-gradient(circle at center, black, transparent 74%)
  pointer-events: none

.site-meta
  padding: 48px 24px 30px
  position: relative
  text-align: left
  z-index: 1

.brand
  background: transparent !important
  border-bottom: 0
  box-shadow: none

.brand:hover
  background: transparent !important

.logo-line
  background: rgba(136, 77, 57, 0.28)

.site-title
  background: transparent !important
  color: var(--ink)
  font-family: var(--font-display)
  font-size: clamp(2.8rem, 4.8vw, 4.7rem)
  font-weight: 800
  letter-spacing: 0
  line-height: 0.96
  text-shadow: 0 10px 28px rgba(136, 77, 57, 0.12)

.site-subtitle
  color: var(--muted)
  font-size: 0.82rem
  font-weight: 700
  letter-spacing: 0.16em
  margin-top: 14px
  text-transform: uppercase

.site-nav
  background: transparent

.menu
  display: flex
  flex-wrap: wrap
  gap: 8px
  justify-content: center
  padding: 0 16px 26px
  position: relative
  z-index: 1

.menu-item a
  background: rgba(255, 253, 248, 0.72)
  border: 1px solid var(--line)
  border-radius: var(--radius-s)
  box-shadow: 0 10px 24px rgba(10, 22, 27, 0.12)
  color: var(--ink)
  font-size: 0.76rem
  font-weight: 800
  letter-spacing: 0.12em
  padding: 10px 14px
  position: relative
  text-transform: uppercase
  transition: background .2s ease, border-color .2s ease, box-shadow .2s ease, color .2s ease, transform .2s ease

.menu-item a:visited
  color: var(--ink)

.menu-item a:after
  content: ""
  position: absolute
  left: 12px
  right: 12px
  bottom: 6px
  height: 2px
  background: var(--clay-bright)
  transform: scaleX(0)
  transform-origin: left
  transition: transform .22s var(--ease-editorial)

.menu-item a i
  color: var(--clay)

.menu-item a:hover,
.menu-item-active a
  background: var(--white)
  border-color: var(--line-warm)
  box-shadow: 0 14px 28px rgba(18, 36, 44, 0.13)
  color: var(--ink)
  transform: translateY(-1px)

.menu-item a:hover:after,
.menu-item-active a:after
  transform: scaleX(1)

.menu-item a:hover i,
.menu-item-active a i
  color: var(--clay)

.main-inner
  max-width: 1120px
  padding-top: 18px
  width: unquote('calc(100% - 36px)')

.sidebar
  margin-right: 24px

.sidebar-inner,
.sidebar-nav,
.sidebar-panel,
.site-overview,
.post-toc
  background: transparent

.sidebar-inner
  background: linear-gradient(180deg, rgba(255, 253, 248, 0.9), rgba(236, 228, 210, 0.9))
  border: 1px solid var(--line)
  border-radius: var(--radius-m)
  box-shadow: var(--shadow-soft), inset 0 1px 0 rgba(255, 255, 255, 0.45)
  margin-top: 1em
  overflow: hidden
  padding: 12px

.sidebar a
  color: var(--link-color)
  border-bottom: 1px solid rgba(136, 77, 57, 0.28)
  font-weight: 600

.sidebar a:hover,
.sidebar a:focus
  color: var(--link-hover-color)
  border-bottom-color: rgba(18, 55, 68, 0.38)

.sidebar-nav
  border-bottom: 1px solid var(--line)
  padding-bottom: 10px

.sidebar-nav li
  color: var(--muted)
  font-size: 0.72rem
  font-weight: 800
  letter-spacing: 0.12em
  text-transform: uppercase

.sidebar-nav li:hover,
.sidebar-nav .sidebar-nav-active,
.sidebar-toc-active .sidebar-nav-toc,
.sidebar-overview-active .sidebar-nav-overview
  color: var(--ink)
  border-bottom-color: var(--clay)
  font-weight: 800

.post-toc .nav .active > a,
.post-toc .nav .active > a:hover,
.post-toc .nav .active-current > a,
.post-toc .nav .active-current > a:hover
  color: var(--link-color)
  border-bottom-color: rgba(136, 77, 57, 0.38)
  font-weight: 800

.site-author-name,
.site-state-item-count
  color: var(--ink)
  font-family: var(--font-display)

.site-author-name
  font-size: 1.8rem
  font-weight: 800

.site-state-item
  border-left-color: var(--line)

.site-state-item-name
  color: var(--muted)
  font-size: 0.68rem
  letter-spacing: 0.12em
  text-transform: uppercase

.post-block,
.pagination,
.comments,
.post-navigation
  background: linear-gradient(180deg, rgba(255, 253, 248, 0.92), rgba(248, 244, 234, 0.88))
  border: 1px solid var(--line)
  border-radius: var(--radius-m)
  box-shadow: var(--shadow-soft), inset 0 1px 0 rgba(255, 255, 255, 0.42)

.post-block
  overflow: hidden
  position: relative
  transition: transform .24s var(--ease-editorial), box-shadow .24s ease, border-color .24s ease

.post-block:before
  content: ""
  position: absolute
  inset: 0
  background: linear-gradient(180deg, rgba(255, 253, 248, 0.16), transparent 28%)
  pointer-events: none

.post-block:hover
  border-color: var(--line-warm)
  box-shadow: var(--shadow), inset 0 1px 0 rgba(255, 255, 255, 0.42)
  transform: translateY(-3px)

.page .post-header,
.post-header
  padding: 34px 40px 10px
  position: relative
  z-index: 1

.page .post-header:after,
.post-header:after
  content: ""
  display: block
  height: 2px
  margin-top: 18px
  width: 92px
  background: linear-gradient(90deg, var(--clay), rgba(136, 77, 57, 0))

.post-title,
.post-title-link
  color: var(--ink)
  font-family: var(--font-display)
  font-size: clamp(2.5rem, 3.6vw, 3.6rem)
  font-weight: 800
  letter-spacing: 0
  line-height: 0.98

.post-title-link:hover
  color: var(--clay)

.post-meta,
.post-description
  color: var(--muted)

.post-body
  color: var(--ink-soft)
  font-size: 1rem
  line-height: 1.85
  padding: 0 40px 38px
  position: relative
  z-index: 1

.post-body p,
.post-body li
  max-width: 72ch

.post-body h1,
.post-body h2,
.post-body h3,
.post-body h4,
.post-body h5,
.post-body h6
  color: var(--ink)
  font-family: var(--font-display)
  font-weight: 800
  letter-spacing: 0
  margin-bottom: 0.45em
  margin-top: 1.45em

.post-body h2
  font-size: 2.25rem

.post-body h3
  font-size: 1.72rem

.post-body h4
  font-size: 1.32rem

.post-body a
  color: var(--link-color)
  border-bottom: 1px solid rgba(136, 77, 57, 0.28)
  font-weight: 700

.post-body a:hover,
.post-body a:focus
  color: var(--link-hover-color)
  border-bottom-color: rgba(18, 55, 68, 0.38)

.post-body hr
  border-color: transparent
  border-top: 1px solid var(--line)

.post-body blockquote
  background: rgba(236, 228, 210, 0.52)
  border-left: 3px solid rgba(136, 77, 57, 0.46)
  border-radius: 0 var(--radius-s) var(--radius-s) 0
  color: var(--ink-soft)
  margin: 1.5rem 0
  padding: 1rem 1.2rem

.post-body img
  border-radius: var(--radius-m)
  box-shadow: var(--shadow-soft)

.post-body table
  background: rgba(255, 253, 248, 0.78)
  border: 1px solid var(--line)
  border-collapse: collapse
  border-radius: var(--radius-m)
  margin: 1.5rem 0
  overflow: hidden
  width: 100%

.post-body th,
.post-body td
  border-bottom: 1px solid rgba(23, 32, 36, 0.1)
  color: var(--ink-soft)
  padding: 0.95rem 1rem

.post-body th
  background: rgba(236, 228, 210, 0.72)
  color: var(--ink)
  font-weight: 800
  text-align: left

.post-body tr:last-child td
  border-bottom: 0

.post-body table a
  color: #6f3a2a
  border-bottom-color: rgba(111, 58, 42, 0.34)
  font-weight: 800

.post-body table a:hover,
.post-body table a:focus
  color: var(--navy)
  border-bottom-color: rgba(18, 55, 68, 0.44)

.post-body .contact-container
  margin-top: 34px
  text-align: center

.post-body .contact-intro
  color: var(--muted)
  font-size: 1.12em
  line-height: 1.6
  margin-bottom: 34px

.post-body .contact-cards
  display: flex
  flex-wrap: wrap
  gap: 18px
  justify-content: center

.post-body .contact-card,
.post-body .contact-card:link,
.post-body .contact-card:visited
  align-items: center
  background: linear-gradient(180deg, rgba(255, 253, 248, 0.92), rgba(236, 228, 210, 0.86)) !important
  border: 1px solid var(--line) !important
  border-radius: var(--radius-m) !important
  box-shadow: var(--shadow-soft), inset 0 1px 0 rgba(255, 255, 255, 0.42) !important
  color: var(--ink) !important
  display: flex
  flex-direction: column
  min-width: 210px
  padding: 28px 22px !important
  text-decoration: none !important
  transition: transform .24s var(--ease-editorial), box-shadow .24s ease, border-color .24s ease !important

.post-body .contact-card:hover,
.post-body .contact-card:focus
  background: var(--white) !important
  border-color: var(--line-warm) !important
  box-shadow: var(--shadow) !important
  color: var(--ink) !important
  transform: translateY(-4px) !important

.post-body .contact-card .contact-icon
  color: var(--clay) !important
  font-size: 2em
  margin-bottom: 18px
  transition: transform .24s var(--ease-editorial)

.post-body .contact-card:hover .contact-icon
  transform: scale(1.08)

.post-body .contact-card .contact-label
  color: var(--ink) !important
  font-family: var(--font-display)
  font-size: 1.28em
  font-weight: 800

.post-body .contact-card .contact-value
  color: #6f3a2a !important
  font-weight: 800
  margin-top: 8px

.btn,
button,
summary.btn,
.post-button .btn
  background: var(--ink)
  border: 1px solid var(--ink)
  border-radius: var(--radius-s)
  box-shadow: 0 10px 22px rgba(18, 36, 44, 0.14)
  color: var(--white)
  font-size: 0.78rem
  font-weight: 800
  letter-spacing: 0.12em
  padding: 10px 18px
  text-transform: uppercase
  transition: transform .2s ease, box-shadow .2s ease, background .2s ease, color .2s ease

.btn:hover,
button:hover,
summary.btn:hover,
.post-button .btn:hover
  background: transparent
  color: var(--ink)
  transform: translateY(-1px)

.pagination
  margin-top: 32px
  padding: 12px

.page-number,
.extend
  border-radius: var(--radius-s)
  color: var(--ink-soft)

.page-number.current
  background: rgba(136, 77, 57, 0.12)
  color: var(--clay)

.post-tags a,
.tag-cloud a,
.sidebar .links-of-blogroll-item a
  background: rgba(236, 228, 210, 0.64)
  border: 1px solid var(--line)
  border-radius: var(--radius-pill)
  color: var(--ink-soft)
  display: inline-block
  margin: 0 8px 8px 0
  padding: 0.38rem 0.78rem

.post-tags a:hover,
.tag-cloud a:hover,
.sidebar .links-of-blogroll-item a:hover
  background: var(--white)
  border-color: var(--line-warm)
  color: var(--link-hover-color)

.post-eof
  background: var(--line)

.footer
  background: linear-gradient(180deg, var(--ink), var(--navy))
  border-top: 1px solid rgba(255, 253, 248, 0.1)

.footer-inner,
.copyright,
.powered-by,
.theme-info
  color: rgba(255, 253, 248, 0.72)

.footer a
  color: #f0c56d

.footer a:hover
  color: var(--white)

.back-to-top
  background: rgba(23, 32, 36, 0.86)
  color: var(--white)

@media (prefers-reduced-motion: reduce)
  html
    scroll-behavior: auto

  .menu-item a,
  .menu-item a:after,
  .post-block,
  .post-body .contact-card,
  .btn,
  button,
  summary.btn,
  .post-button .btn
    transition: none !important

  .menu-item a:hover,
  .menu-item-active a,
  .post-block:hover,
  .post-body .contact-card:hover,
  .post-body .contact-card:focus,
  .btn:hover,
  button:hover,
  summary.btn:hover,
  .post-button .btn:hover
    transform: none !important

@media (max-width: 991px)
  .main-inner
    width: unquote('calc(100% - 24px)')

  .sidebar
    margin-right: 0

  .site-brand-container
    max-width: unquote('calc(100% - 20px)')

  .page .post-header,
  .post-header
    padding: 28px 24px 8px

  .post-body
    padding: 0 24px 28px

@media (max-width: 767px)
  body
    font-size: 16px

  .site-meta
    padding: 40px 16px 24px

  .site-title
    font-size: 2.9rem

  .site-subtitle
    letter-spacing: 0.12em

  .menu
    display: grid
    grid-template-columns: repeat(2, minmax(0, 1fr))
    padding: 0 14px 20px

  .menu-item a
    display: block
    font-size: 0.72rem
    padding: 10px 12px
    text-align: center

  .main-inner
    width: unquote('calc(100% - 16px)')

  .post-block,
  .pagination,
  .comments,
  .post-navigation,
  .sidebar-inner
    border-radius: var(--radius-m)

  .post-title,
  .post-title-link
    font-size: 2.55rem

  .post-body h2
    font-size: 2rem

  .post-body table
    display: block
    overflow-x: auto

  .post-body .contact-card,
  .post-body .contact-card:link,
  .post-body .contact-card:visited
    width: 100%
